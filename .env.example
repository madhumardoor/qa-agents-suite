# ============================================================
# QA Agents Suite - Environment Configuration
# ============================================================
# Copy this file to `.env` in the project root and fill in ONLY
# the values for the services you actually want to connect live.
#
# Anything left blank will cause that specific integration to
# automatically fall back to mock/local behavior, even if MODE=live,
# and a warning will be printed. This lets you go live incrementally
# (e.g. real LLM + mock everything else) without breaking anything.
# ============================================================

# ---- Global mode switch ----
# mock = no keys required, uses local sample data (default)
# live = calls real services for every key that is filled in below
MODE=mock

# ---- LLM (used by Agent 1 for smarter test-case generation,
#           Agent 3 for root-cause summaries) ----
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Jira (Agent 1: read PRDs / write comments; Agent 3: create bug tickets) ----
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=QA

# ---- TestRail (Agent 1: export generated test cases) ----
TESTRAIL_BASE_URL=https://yourcompany.testrail.io
TESTRAIL_EMAIL=you@yourcompany.com
TESTRAIL_API_KEY=
TESTRAIL_PROJECT_ID=1

# ---- Jenkins (Agent 3: fetch CI console logs) ----
JENKINS_BASE_URL=https://jenkins.yourcompany.com
JENKINS_USER=you
JENKINS_API_TOKEN=

# ---- Slack (Agent 3: post failure summaries) ----
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#qa-alerts

# ---- OWASP ZAP (Agent 4: security scanning) ----
# Run ZAP locally with:
#   docker run -p 8080:8080 zaproxy/zap-stable zap.sh -daemon -host 0.0.0.0 -port 8080 -config api.disablekey=true
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=

# ---- Applitools / Percy (Agent 5: optional cloud visual-diff providers) ----
# Not required — Agent 5's built-in Pillow-based pixel diff works without these.
APPLITOOLS_API_KEY=
PERCY_TOKEN=

# ---- GitHub (Agent 5: post PR comments) ----
GITHUB_TOKEN=
GITHUB_REPO=yourorg/yourrepo
